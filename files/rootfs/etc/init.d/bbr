#!/bin/sh /etc/rc.common
# BBR 加速 —— 按 UCI 配置应用 TCP 拥塞控制算法
#
# 用法：
#   /etc/init.d/bbr reload   应用当前配置（LuCI 保存后自动调用）
#
# 只有一个配置项：bbr.main.algorithm
#   bbr   → 开启 BBR 加速
#   cubic → 恢复系统默认
#   ...
#
# 注意：
#   1. rc.common 只认 start/stop/restart/reload 等标准 action，
#      “apply” 不是合法 action（会变成 help，什么都不做）。
#   2. 这里只管 TCP 拥塞控制算法，不碰 net.core.default_qdisc——
#      OpenWrt 上该参数由 netifd 接管，写不进去；而且现有网卡的
#      队列（如 mq）在网卡创建时就定死了，改内核默认值也无效。
#      BBR 并不强制需要 fq：内核 4.13+ 有 TCP internal pacing 兜底，
#      OpenWrt 官方默认组合就是 fq_codel + bbr。

START=98
STOP=98
USE_PROCD=1   # 关键：让 rc.common 调用 service_triggers() 注册 reload trigger

DISABLE_CONF=/etc/sysctl.d/99-bbr-disable.conf

apply() {
	local algorithm rc=0 available
	algorithm=$(uci -q get bbr.main.algorithm)
	[ -n "$algorithm" ] || algorithm=bbr

	# 加载 bbr 内核模块（kmod-tcp-bbr 有自动探测，这里兜底）
	modprobe tcp_bbr 2>/dev/null

	# 白名单校验：只接受内核实际支持的算法。
	# 否则无效值会写进 /etc/sysctl.d/99-bbr-disable.conf（下次启动报错），
	# 且 LuCI 的 sh() 会吞掉写入 /proc/sys 的错误，用户毫不知情。
	available=$(cat /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null)
	if [ -n "$available" ]; then
		case " $available " in
			*" $algorithm "*) ;;
			*)
				logger -t bbr "invalid algorithm '$algorithm', fallback to cubic (available: $available)"
				algorithm=cubic
				;;
		esac
	fi

	if [ "$algorithm" = "bbr" ]; then
		# 选 BBR：移除任何覆盖，用内核自带配置 + 本脚本
		rm -f "$DISABLE_CONF"
	else
		# 选了别的算法：写覆盖文件压过 kmod 自带的 12-tcp-bbr.conf，
		# 保证重启后仍然是选中的算法（sysctl 按字典序，99 在 12 之后）
		echo "net.ipv4.tcp_congestion_control=$algorithm" > "$DISABLE_CONF"
	fi

	echo "$algorithm" > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || rc=1

	# 记一笔到日志，方便排查
	logger -t bbr "want=$algorithm now=$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null) rc=$rc"
	return $rc
}

# 用 procd 风格：这样 rc.common 才会调用 service_triggers()，
# 进而注册 config.change trigger。没有 USE_PROCD=1 时，
# procd_add_reload_trigger 永远不生效——表现为“保存”后再点
# “未保存的配置 → 应用”时 uci 已改但内核不变。
start_service() {
	apply
}

reload_service() {
	apply
}

stop_service() {
	echo cubic > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null
}

# uci commit bbr 时 procd 自动调 reload_service
service_triggers() {
	procd_add_reload_trigger bbr
}
