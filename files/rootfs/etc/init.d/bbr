#!/bin/sh /etc/rc.common
# BBR 加速 —— 按 UCI 配置应用 TCP 拥塞控制算法
#
# 用法：
#   /etc/init.d/bbr reload   应用当前配置（LuCI 保存后自动调用）
#
# 注意：
#   1. rc.common 只认 start/stop/restart/reload 等标准 action，
#      “apply” 不是合法 action（会变成 help，什么都不做）。
#   2. 这里只管 TCP 拥塞控制算法，不碰 net.core.default_qdisc——
#      OpenWrt 上该参数由 netifd 接管，写不进去；而且现有网卡的
#      队列（如 mq）在网卡创建时就定死了，改内核默认值也无效。
#      BBR 并不强制需要 fq：内核 4.13+ 有 TCP internal pacing 兜底，
#      OpenWrt 官方默认组合就是 fq_codel + bbr。

START=98
STOP=98

DISABLE_CONF=/etc/sysctl.d/99-bbr-disable.conf

apply() {
	local enabled algorithm rc=0
	enabled=$(uci -q get bbr.main.enabled)
	algorithm=$(uci -q get bbr.main.algorithm)
	[ -n "$enabled" ] || enabled=0
	[ -n "$algorithm" ] || algorithm=bbr

	if [ "$enabled" = "1" ]; then
		# 加载 bbr 内核模块（kmod-tcp-bbr 有自动探测，这里兜底）
		modprobe tcp_bbr 2>/dev/null
		# 移除禁用覆盖
		rm -f "$DISABLE_CONF"
		echo "$algorithm" > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || rc=1
	else
		# 写开机覆盖文件（字典序在 12-tcp-bbr.conf 之后，最终生效）
		cat > "$DISABLE_CONF" <<EOF
# 由 /etc/init.d/bbr 生成：BBR 已禁用
net.ipv4.tcp_congestion_control=cubic
EOF
		echo cubic > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || rc=1
	fi

	# 记一笔到日志，方便排查
	logger -t bbr "enabled=$enabled want=$algorithm now=$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null) rc=$rc"
	return $rc
}

start() {
	apply
}

stop() {
	echo cubic > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null
}

restart() {
	apply
}

# LuCI 保存后、uci commit 后都会调 reload（标准 action）
reload() {
	apply
}

# uci commit bbr 时自动重载（LuCI 保存后立即生效）
service_triggers() {
	procd_add_reload_trigger bbr
}
